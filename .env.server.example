# Copy to `.env` on the server:   cp .env.server.example .env
# Then fill every `change-me` value. Keep this file out of git (it is ignored).

APP_NAME="PPAK UTHM Connect"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.example.com
APP_KEY=change-me
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Your domain (or free DuckDNS names). Both must point at this server.
# App: app.example.com · WebSocket: ws.example.com
DOMAIN=app.example.com
WS_DOMAIN=ws.example.com

# Postgres runs in the compose network; nothing is published to the host.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ppak
DB_USERNAME=ppak
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ppak
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
REVERB_HOST=reverb
REVERB_PORT=8082
REVERB_SCHEME=http

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Email is optional for a demo; the in-app bell works without it.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@ppakuthm.com"
MAIL_FROM_NAME="${APP_NAME}"

# Photos stay on a Docker volume (private, served through the app).
MEDIA_DISK=attendance
MEDIA_MAX_UPLOAD_KB=10240
MEDIA_MAX_PIXELS=20000000
CHECKOUT_PHOTO_REQUIRED=true
CHECKOUT_PHOTO_RETENTION_DAYS=3

# Lower this to 256M on a 1 GB VPS (see DEPLOY-SERVER.md).
PHP_MEMORY_LIMIT=384M

# Seeds the demo on first boot, then set to false.
DEMO_SEED=true

# Stripe remains a provisional adapter; leave unset for the demo.
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
